@startuml HR_Module_Leave_Attendance
skinparam backgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor #2c3e50
skinparam actorBorderColor #2c3e50
skinparam usecaseFontColor #2c3e50
skinparam fontSize 12
skinparam defaultFontName Arial

title Leave & Attendance Module - Detailed Use Case

left to right direction

actor "Super Admin" as superadmin #e74c3c
actor "HR Manager" as hrmanager #2ecc71
actor "Employee" as employee #f39c12

package "Attendance Tracking" {
  usecase "Record Attendance" as UC_ATT_RECORD
  usecase "Update Attendance" as UC_ATT_UPDATE
  usecase "Delete Attendance" as UC_ATT_DELETE
  usecase "Query by Company" as UC_ATT_COMPANY
  usecase "Query by Employee" as UC_ATT_EMPLOYEE
  usecase "Query by Date Range" as UC_ATT_DATE
}

package "Leave Management" {
  usecase "Configure Leave Types" as UC_LEAVE_TYPE_CREATE
  usecase "Update Leave Types" as UC_LEAVE_TYPE_UPDATE
  usecase "Submit Leave Request (Public)" as UC_LEAVE_SUBMIT
  usecase "Submit Leave Request (Authenticated)" as UC_LEAVE_SUBMIT_AUTH
  usecase "Approve Leave Request" as UC_LEAVE_APPROVE
  usecase "Reject Leave Request" as UC_LEAVE_REJECT
  usecase "View Leave Balances" as UC_LEAVE_BALANCE
}

superadmin --> UC_ATT_RECORD
superadmin --> UC_ATT_UPDATE
superadmin --> UC_ATT_DELETE
superadmin --> UC_ATT_COMPANY
superadmin --> UC_ATT_EMPLOYEE
superadmin --> UC_ATT_DATE

hrmanager --> UC_ATT_RECORD
hrmanager --> UC_ATT_UPDATE
hrmanager --> UC_ATT_DELETE
hrmanager --> UC_ATT_COMPANY
hrmanager --> UC_ATT_EMPLOYEE
hrmanager --> UC_ATT_DATE

hrmanager --> UC_LEAVE_TYPE_CREATE
hrmanager --> UC_LEAVE_TYPE_UPDATE
hrmanager --> UC_LEAVE_APPROVE
hrmanager --> UC_LEAVE_REJECT
hrmanager --> UC_LEAVE_BALANCE

employee --> UC_LEAVE_SUBMIT

@enduml
