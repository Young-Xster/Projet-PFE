# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/dbname
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8081

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=realm_name_here
KEYCLOAK_CLIENT_ID=client_id_here
KEYCLOAK_ADMIN_USERNAME=username_here
KEYCLOAK_ADMIN_PASSWORD=password_here

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
APP_FRONTEND_SUBCONTRACTOR_BASE_URL=http://localhost:44491

# PostgreSQL (for Docker)
POSTGRES_DB=dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
