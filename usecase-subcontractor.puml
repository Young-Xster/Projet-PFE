@startuml HR_Module_Subcontractor
skinparam backgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor #2c3e50
skinparam actorBorderColor #2c3e50
skinparam usecaseFontColor #2c3e50
skinparam fontSize 12
skinparam defaultFontName Arial

title Subcontractor Management Module - Detailed Use Case

left to right direction

actor "Super Admin" as superadmin #e74c3c
actor "HR Manager" as hrmanager #2ecc71
actor "Subcontractor" as subcontractor #1abc9c

package "Subcontractor Management (HR)" {
  usecase "Create Subcontractor" as UC_SUB_CREATE
  usecase "Update Subcontractor" as UC_SUB_UPDATE
  usecase "Delete Subcontractor" as UC_SUB_DELETE
  usecase "View Subcontractors" as UC_SUB_VIEW
  
  usecase "Create Contract" as UC_CONTRACT_CREATE
  usecase "Renew Contract" as UC_CONTRACT_RENEW
  usecase "Terminate Contract" as UC_CONTRACT_TERM
  
  usecase "View Invoices" as UC_INVOICE_VIEW
  usecase "Mark Invoice as Paid" as UC_INVOICE_PAID
  usecase "Upload Payment Proof" as UC_INVOICE_PROOF
  
  usecase "Review Performance" as UC_SUB_PERF
}

package "Subcontractor Portal" {
  usecase "Request Portal Access" as UC_PORTAL_ACCESS
  usecase "View Profile" as UC_PORTAL_PROFILE
  usecase "Update Contact Info" as UC_PORTAL_UPDATE
  usecase "View Contracts" as UC_PORTAL_CONTRACTS
  usecase "Download Contract Documents" as UC_PORTAL_CONTRACT_DOC
  usecase "View Invoices" as UC_PORTAL_INVOICES
  usecase "Create Invoice" as UC_PORTAL_INVOICE_CREATE
  usecase "Upload Payment Proof" as UC_PORTAL_PAYMENT_PROOF
  usecase "Logout" as UC_PORTAL_LOGOUT
}

superadmin --> UC_SUB_CREATE
superadmin --> UC_SUB_UPDATE
superadmin --> UC_SUB_DELETE
superadmin --> UC_SUB_VIEW

hrmanager --> UC_SUB_CREATE
hrmanager --> UC_SUB_UPDATE
hrmanager --> UC_SUB_DELETE
hrmanager --> UC_SUB_VIEW
hrmanager --> UC_CONTRACT_CREATE
hrmanager --> UC_CONTRACT_RENEW
hrmanager --> UC_CONTRACT_TERM
hrmanager --> UC_INVOICE_VIEW
hrmanager --> UC_INVOICE_PAID
hrmanager --> UC_INVOICE_PROOF
hrmanager --> UC_SUB_PERF

subcontractor --> UC_PORTAL_ACCESS
subcontractor --> UC_PORTAL_PROFILE
subcontractor --> UC_PORTAL_UPDATE
subcontractor --> UC_PORTAL_CONTRACTS
subcontractor --> UC_PORTAL_CONTRACT_DOC
subcontractor --> UC_PORTAL_INVOICES
subcontractor --> UC_PORTAL_INVOICE_CREATE
subcontractor --> UC_PORTAL_PAYMENT_PROOF
subcontractor --> UC_PORTAL_LOGOUT

@enduml
