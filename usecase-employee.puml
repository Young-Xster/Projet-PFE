@startuml HR_Module_Employee_Management
skinparam backgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor #2c3e50
skinparam actorBorderColor #2c3e50
skinparam usecaseFontColor #2c3e50
skinparam fontSize 12
skinparam defaultFontName Arial

title Employee Management Module - Detailed Use Case

left to right direction

actor "Super Admin" as superadmin #e74c3c
actor "HR Manager" as hrmanager #2ecc71
actor "Employee" as employee #f39c12

package "Employee Management" {
  usecase "Create Employee" as UC_EMP_CREATE
  usecase "Update Employee Details" as UC_EMP_UPDATE
  usecase "View Employee Profile" as UC_EMP_VIEW
  usecase "Delete Employee" as UC_EMP_DELETE
  usecase "Offboard Employee" as UC_EMP_OFFBOARD
  usecase "Assign Department" as UC_EMP_DEPT
  usecase "Assign Position" as UC_EMP_POS
  usecase "Manage Employee Documents" as UC_EMP_DOCS
  usecase "Upload Document" as UC_DOC_UPLOAD
  usecase "Download Document" as UC_DOC_DOWN
  usecase "Delete Document" as UC_DOC_DEL
  usecase "Verify Employee (Public)" as UC_EMP_VERIFY
}

superadmin --> UC_EMP_CREATE
superadmin --> UC_EMP_UPDATE
superadmin --> UC_EMP_VIEW
superadmin --> UC_EMP_DELETE
superadmin --> UC_EMP_OFFBOARD

hrmanager --> UC_EMP_CREATE
hrmanager --> UC_EMP_UPDATE
hrmanager --> UC_EMP_VIEW
hrmanager --> UC_EMP_DELETE
hrmanager --> UC_EMP_OFFBOARD
hrmanager --> UC_EMP_DEPT
hrmanager --> UC_EMP_POS
hrmanager --> UC_EMP_DOCS
hrmanager --> UC_EMP_VERIFY

employee --> UC_EMP_VERIFY

UC_EMP_DOCS ..> UC_DOC_UPLOAD : <<include>>
UC_EMP_DOCS ..> UC_DOC_DOWN : <<include>>

@enduml
