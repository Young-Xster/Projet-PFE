@startuml HR_Module_Company_User
skinparam backgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor #2c3e50
skinparam actorBorderColor #2c3e50
skinparam usecaseFontColor #2c3e50
skinparam fontSize 12
skinparam defaultFontName Arial

title Company & User Management Module - Detailed Use Case

left to right direction

actor "Super Admin" as superadmin #e74c3c

package "Company Management" {
  usecase "Create Company" as UC_COMP_CREATE
  usecase "Update Company" as UC_COMP_UPDATE
  usecase "Delete Company" as UC_COMP_DELETE
  usecase "View Companies" as UC_COMP_VIEW
  usecase "Configure Company Settings" as UC_COMP_SETTINGS
}

package "User Management" {
  usecase "Create User" as UC_USER_CREATE
  usecase "Update User" as UC_USER_UPDATE
  usecase "Delete User" as UC_USER_DELETE
  usecase "View Users" as UC_USER_VIEW
  usecase "Reset Password" as UC_USER_RESET
}

package "Roles & Permissions" {
  usecase "Create Role" as UC_ROLE_CREATE
  usecase "Update Role" as UC_ROLE_UPDATE
  usecase "Delete Role" as UC_ROLE_DELETE
  usecase "Assign Permissions" as UC_ROLE_PERM
  usecase "View Roles" as UC_ROLE_VIEW
}

package "Activity Logs" {
  usecase "View Activity Logs" as UC_LOG_VIEW
  usecase "Filter by Company" as UC_LOG_COMP
  usecase "Filter by Date" as UC_LOG_DATE
  usecase "Filter by User" as UC_LOG_USER
  usecase "Filter by Entity" as UC_LOG_ENTITY
}

superadmin --> UC_COMP_CREATE
superadmin --> UC_COMP_UPDATE
superadmin --> UC_COMP_DELETE
superadmin --> UC_COMP_VIEW
superadmin --> UC_COMP_SETTINGS

superadmin --> UC_USER_CREATE
superadmin --> UC_USER_UPDATE
superadmin --> UC_USER_DELETE
superadmin --> UC_USER_VIEW
superadmin --> UC_USER_RESET

superadmin --> UC_ROLE_CREATE
superadmin --> UC_ROLE_UPDATE
superadmin --> UC_ROLE_DELETE
superadmin --> UC_ROLE_PERM
superadmin --> UC_ROLE_VIEW

superadmin --> UC_LOG_VIEW
superadmin --> UC_LOG_COMP
superadmin --> UC_LOG_DATE
superadmin --> UC_LOG_USER
superadmin --> UC_LOG_ENTITY

@enduml
