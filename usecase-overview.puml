@startuml HR_System_Overview
skinparam backgroundColor white
skinparam usecaseBackgroundColor white
skinparam usecaseBorderColor #333366
skinparam actorBorderColor #333366
skinparam usecaseFontColor #333366

title HR Management System - High-Level Use Case Diagram

left to right direction

' Actors
actor "Super Admin" as superadmin
actor "HR Manager" as hrmanager
actor "Employee" as employee
actor "Job Seeker" as jobseeker
actor "Subcontractor" as subcontractor

' Main System
rectangle "HR Management System" {
  
  usecase "Manage Companies\n& Users" as UC1
  usecase "Manage Employees\n& Departments" as UC2
  usecase "Track Attendance\n& Schedules" as UC3
  usecase "Manage Leave\nRequests" as UC4
  usecase "Handle Recruitment\n& Hiring" as UC5
  usecase "Evaluate\nPerformance" as UC6
  usecase "Manage\nSubcontractors" as UC7
  usecase "Browse & Apply\nto Jobs" as UC8
  usecase "Submit Leave\nRequest" as UC9
  usecase "Manage Contracts\n& Invoices" as UC10
  usecase "AI-Powered\nAnalytics" as UC11
  
}

' Relationships
superadmin --> UC1
superadmin --> UC2
superadmin --> UC3
superadmin --> UC4
superadmin --> UC5
superadmin --> UC6
superadmin --> UC7

hrmanager --> UC2
hrmanager --> UC3
hrmanager --> UC4
hrmanager --> UC5
hrmanager --> UC6
hrmanager --> UC7
hrmanager --> UC11

employee --> UC9

jobseeker --> UC8

subcontractor --> UC10

UC11 ..> UC5 : <<include>>
UC11 ..> UC6 : <<include>>

@enduml
